# Chế độ PayPal: "sandbox" (thử nghiệm) hoặc "live" (tiền thật)
PAYPAL_MODE=live

# Lấy từ developer.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Mật mã bí mật khớp với Recordly App (mặc định đã cấu hình sẵn)
LICENSE_SECRET_KEY=RECORDLY_PRO_MASTER_SECRET_2026_COMMERCIAL

# (Tùy chọn) Gửi email qua Gmail của bạn
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# (Hoặc tùy chọn) Gửi email qua Resend miễn phí
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Recordly PRO <license@yourdomain.com>
